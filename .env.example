###########################################################
######################### 必 填 ###########################
##########################################################

### 在 https://developers.line.biz/ 申請到的資訊 ############

LINE_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

#機器人連線使用
DB_PASSWORD=

#管理員連線使用，USER為帳號、PASSWORD為密碼，自己設定即可
DB_USER=
DB_USER_PASSWORD=
REDIS_PASSWORD=

###########################################################
######################### 選 填 ###########################
##########################################################

### Line Front-end Framwork Id 用於 Line 網頁應用程式 #######

#LINE_LIFF_ID=
#LINE_LIFF_COMPACT_ID=
#LINE_LIFF_TALL_ID=
#LINE_LIFF_FULL_ID=

### LINE Login Channel（LIFF 管理用，make cf-tunnel 自動更新 LIFF endpoint）
### LINE_LOGIN_CHANNEL_ID 同時是 runtime 必要設定：
###   POST /api/auth/session 會拿它當 client_id 去 LINE 驗證 LIFF ID token，
###   沒設定的話登入服務會回 503。必須是 LIFF app 所屬的那個 Login channel。
#LINE_LOGIN_CHANNEL_ID=
#LINE_LOGIN_CHANNEL_SECRET=

### Google Gemini AI API Key ################################

#GEMINI_API_KEY=

### Imgur 圖片上傳 ##########################################

#IMGUR_CLIENT_ID=

### 抽卡除錯 log（開啟後 [gacha-draw]/[gacha-banner]/[gacha-result]/[gacha-normal] 會輸出）####
#GACHA_DEBUG_LOG=1

###########################################################
################## 不 會 設 定 請 勿 動 #####################
##########################################################

PROJECT_NAME=redive
### 正式站的 canonical origin，也是 cookie session 的 same-origin 白名單來源。
### 可寫 host（pudding.hanshino.dev）或含 scheme（https://pudding.hanshino.dev）。
### make cf-tunnel 會就地覆寫成當下的 trycloudflare host。
APP_DOMAIN=redivebot.local

### 使用資料庫名稱 #########################################
DB_DATABASE=Princess

### 資料庫連線配置 #########################################
DB_HOST=mysql
DB_PORT=3306

### 快取資料庫連線配置 #####################################
REDIS_PORT=6379
REDIS_HOST=redis

TZ=Asia/Taipei
LANG=zh_TW.UTF-8

### Umami Analytics ############################################
UMAMI_URL=
UMAMI_WEBSITE_ID=

### PictShare 圖片上傳服務 ######################################
PICTSHARE_URL=
PICTSHARE_UPLOAD_CODE=
